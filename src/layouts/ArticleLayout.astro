---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data } = entry;
const canonical = data.canonical ?? new URL(data.path, Astro.site).href;
const date = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long', timeZone: 'Asia/Shanghai' }).format(data.publishedAt);
---

<BaseLayout title={data.title} description={data.description} canonical={canonical} type="article" publishedAt={data.publishedAt} updatedAt={data.updatedAt} tags={data.tags} bodyClass={`article-theme article-theme--${data.design}`}>
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="shell">
    <SiteHeader issue={`${data.category} / ${data.articleType}`} />
    <main>
      <article>
        <header class="article-head">
          <div class="article-meta"><span>{data.category}</span><span>{data.articleType}</span><time datetime={data.publishedAt.toISOString()}>{date}</time></div>
          <h1>{data.title}</h1>
          <p>{data.description}</p>
        </header>
        <div class="article-grid">
          <aside class="toc" aria-label="文章目录"><strong>ON THIS PAGE</strong><nav id="toc-links"></nav></aside>
          <div class="prose"><slot /></div>
        </div>
      </article>
    </main>
    <SiteFooter />
  </div>
  <script>
    const prose = document.querySelector('.prose');
    const links = document.querySelector('#toc-links');
    const progress = document.querySelector<HTMLElement>('.reading-progress');
    if (prose && links) {
      const headings = [...prose.querySelectorAll('h2')];
      headings.forEach((heading, index) => {
        heading.id ||= `section-${index + 1}`;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        links.append(link);
      });
      if (!headings.length) links.closest('.toc')?.remove();
    }
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (progress) progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    };
    updateProgress();
    addEventListener('scroll', updateProgress, { passive: true });
    addEventListener('resize', updateProgress);
  </script>
</BaseLayout>

<style is:global>
  :root{--paper:#f0eee7;--ink:#171714;--muted:#716f67;--line:#c9c5b9;--accent:#e1432f;--soft:#d7f15a;--pad:clamp(20px,4vw,64px)}
  .article-theme{background:var(--paper);color:var(--ink);font-family:"Songti SC","Noto Serif CJK SC",Georgia,serif}.article-theme--editorial{--paper:#162b25;--ink:#f3edda;--muted:#b9b3a2;--line:#52645d;--accent:#ff795f;--soft:#d7f15a}.article-theme--manifesto{--paper:#ee583b;--ink:#171713;--muted:#4f241c;--line:#171713;--accent:#f4eecf;--soft:#f4eecf}.shell{max-width:1600px;margin:auto;padding:0 var(--pad)}.reading-progress{position:fixed;inset:0 0 auto;height:4px;background:var(--accent);transform:scaleX(0);transform-origin:left;z-index:20}.article-head{padding:clamp(70px,10vw,150px) 0 clamp(55px,8vw,110px);border-bottom:1px solid var(--ink)}.article-meta{display:flex;flex-wrap:wrap;gap:10px 24px;color:var(--muted);font:10px Arvo,sans-serif;letter-spacing:.12em;text-transform:uppercase}.article-head h1{max-width:1180px;margin:30px 0;font:500 clamp(48px,8vw,124px)/.98 "Heiti SC","PingFang SC",sans-serif;letter-spacing:-.06em}.article-head p{max-width:760px;margin:0;font-size:clamp(18px,1.6vw,24px);line-height:1.7}.article-grid{display:grid;grid-template-columns:200px minmax(0,760px);justify-content:center;gap:clamp(40px,7vw,110px);padding:clamp(60px,8vw,120px) 0}.toc{align-self:start;position:sticky;top:30px;font:10px/1.5 Arvo,sans-serif;letter-spacing:.05em}.toc strong{display:block;color:var(--accent);letter-spacing:.15em;margin-bottom:14px}.toc nav{display:grid;gap:9px}.toc a{text-decoration:none;color:var(--muted)}.toc a:hover{color:var(--ink)}.prose{font-size:clamp(17px,1.35vw,20px);line-height:1.9;min-width:0}.prose p,.prose ul,.prose ol{margin:0 0 1.45em}.prose h2,.prose h3{font-family:"Heiti SC","PingFang SC",sans-serif;line-height:1.2;scroll-margin-top:30px}.prose h2{font-size:clamp(32px,4vw,54px);letter-spacing:-.035em;font-weight:500;margin:2.2em 0 .7em}.prose h3{font-size:clamp(23px,2.3vw,31px);margin:1.8em 0 .65em}.prose blockquote{margin:2em 0;padding:.6em 0 .6em 1.4em;border-left:4px solid var(--accent);font-size:1.12em}.prose pre{padding:22px;overflow:auto;background:var(--ink);color:var(--paper);border-radius:2px;font:14px/1.7 ui-monospace,SFMono-Regular,Consolas,monospace}.prose :not(pre)>code{padding:.15em .35em;background:color-mix(in srgb,var(--ink) 10%,transparent)}.prose img{max-width:100%;height:auto}.prose a{text-decoration-color:var(--accent);text-decoration-thickness:2px}.prose table{display:block;overflow:auto;border-collapse:collapse;margin:2em 0}.prose th,.prose td{padding:10px 14px;border:1px solid var(--line);text-align:left}
  @media(max-width:850px){.article-grid{grid-template-columns:minmax(0,760px)}.toc{display:none}.article-head h1{font-size:clamp(44px,12vw,76px)}}
</style>
